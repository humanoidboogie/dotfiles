#!/bin/bash

# niri
rm -f ~/.config/niri/config.kdl
mkdir -p ~/.config/niri
stow -t ~ niri

# Noctalia
rm -f ~/.config/noctalia/config.toml
mkdir -p ~/.config/noctalia
stow -t ~ noctalia

# nvim
rm -rf ~/.config/nvim
rm -f ~/.config/nvim
stow -t ~ nvim

# kitty
rm -f ~/.config/kitty/kitty.conf
mkdir -p ~/.config/kitty
stow -t ~ kitty

# bashrc
rm -f ~/.bashrc
stow -t ~ bashrc

# fish
rm -f ~/.config/fish/config.fish
mkdir -p ~/.config/fish
stow -t ~ fish
