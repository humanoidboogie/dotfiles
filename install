#!/bin/bash

# umbriel
rm -f ~/.config/umbriel/config.toml
mkdir -p ~/.config/umbriel
stow -t ~ umbriel

# Noctalia
rm -f ~/.config/noctalia/config.toml
mkdir -p ~/.config/noctalia
stow -t ~ noctalia

# kitty
rm -f ~/.config/kitty/kitty.conf
mkdir -p ~/.config/kitty
stow -t ~ kitty

# fish
rm -f ~/.config/fish/config.fish
mkdir -p ~/.config/fish
stow -t ~ fish
